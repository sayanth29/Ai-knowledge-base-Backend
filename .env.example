# ── Environment ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_base

# ── External services ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
QDRANT_URL=http://localhost:6333

# ── Auth / JWT ───────────────────────────────────────────────────
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]